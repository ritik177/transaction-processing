{
  "name": "transaction-webhook-service",
  "version": "1.0.0",
  "description": "Reliable transaction webhook processing with Express, MongoDB, BullMQ, and Redis",
  "private": false,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/workers/transaction.worker.js",
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/workers/transaction.worker.js",
    "test": "node --test",
    "test:integration": "RUN_INTEGRATION_TESTS=true node --test tests/transactions.test.js"
  },
  "dependencies": {
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "mongoose": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
